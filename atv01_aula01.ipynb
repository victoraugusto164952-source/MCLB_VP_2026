        "# ==============================================================================\n",
        "# 1. IMPORTAÇÃO DE BIBLIOTECAS ESSENCIAIS\n",
        "# ==============================================================================\n",
        "# Importa o módulo sys para verificar a versão do interpretador Python rodando no Colab\n",
        "import sys\n",
        "\n",
        "# Importa a biblioteca scikit-learn (sklearn), principal ferramenta de ML em Python\n",
        "import sklearn\n",
        "\n",
        "# Importa a biblioteca pandas para manipulação e análise de dados estruturados\n",
        "import pandas as pd\n",
        "\n",
        "# Importa a biblioteca numpy para operações matemáticas e vetoriais de alta performance\n",
        "import numpy as np\n",
        "\n",
        "# ==============================================================================\n",
        "# 2. VALIDAÇÃO E DIAGNÓSTICO DO AMBIENTE\n",
        "# ==============================================================================\n",
        "# Imprime um cabeçalho para organização visual do log\n",
        "print(\"=== VALIDAÇÃO DO AMBIENTE DE DESENVOLVIMENTO ===\")\n",
        "\n",
        "# Exibe no console a versão exata do Python que está sendo executada\n",
        "print(f\"Versão do Python: {sys.version}\")\n",
        "\n",
        "# Exibe a versão instalada do Scikit-Learn para garantir compatibilidade\n",
        "print(f\"Versão do Scikit-Learn: {sklearn.__version__}\")\n",
        "\n",
        "# Exibe a versão instalada do Pandas\n",
        "print(f\"Versão do Pandas: {pd.__version__}\")\n",
        "\n",
        "# Mensagem confirmando que todas as bibliotecas padrão carregaram sem erros\n",
        "print(\"Status do Ambiente: PRONTO E CONFIGURADO COM SUCESSO!\\n\")\n",
        "\n",
        "# ==============================================================================\n",
        "# 3. PREPARAÇÃO DO DATASET DE TREINAMENTO (SUPERVISIONADO)\n",
        "# ==============================================================================\n",
        "# Cria uma lista de strings contendo as frases que serão usadas para ensinar o modelo\n",
        "mensagens_treino = [\n",
        "    \"Adorei o atendimento, muito rápido\",\n",
        "    \"Péssimo serviço, não resolveram meu problema\",\n",
        "    \"Muito bom o bot, respondeu direitinho\",\n",
        "    \"Horrível, estou muito insatisfeito\",\n",
        "    \"Excelente suporte, parabéns\"\n",
        "]\n",
        "\n",
        "# Cria a lista de rótulos (labels/gabarito) correspondente exatamente a cada frase acima\n",
        "rotulos_treino = [\n",
        "    \"positivo\",\n",
        "    \"negativo\",\n",
        "    \"positivo\",\n",
        "    \"negativo\",\n",
        "    \"positivo\"\n",
        "]\n",
        "\n",
        "# ==============================================================================\n",
        "# 4. ENGENHARIA DE FEATURES (VETORIZAÇÃO DE TEXTO)\n",
        "# ==============================================================================\n",
        "# Importa a classe CountVectorizer, que transforma texto em matriz numérica de contagem de palavras\n",
        "from sklearn.feature_extraction.text import CountVectorizer\n",
        "\n",
        "# Instancia o objeto vetorizador na memória\n",
        "vetorizador = CountVectorizer()\n",
        "\n",
        "# O método fit_transform lê todo o texto, cria o vocabulário único e converte as frases em números\n",
        "matriz_vetorizada = vetorizador.fit_transform(mensagens_treino)\n",
        "\n",
        "# ==============================================================================\n",
        "# 5. MODELAGEM E TREINAMENTO DO ALGORITMO\n",
        "# ==============================================================================\n",
        "# Importa o algoritmo Naive Bayes (MultinomialNB), ideal para classificação de texto\n",
        "from sklearn.naive_bayes import MultinomialNB\n",
        "\n",
        "# Instancia o classificador Naive Bayes\n",
        "modelo_classificador = MultinomialNB()\n",
        "\n",
        "# O método fit realiza o aprendizado: conecta os vetores numéricos aos seus respectivos rótulos\n",
        "modelo_classificador.fit(matriz_vetorizada, rotulos_treino)\n",
        "\n",
        "# Imprime confirmação de que o modelo concluiu o treinamento\n",
        "print(\"=== MODELO TREINADO COM SUCESSO ===\\n\")\n",
        "\n",
        "# ==============================================================================\n",
        "# 6. TESTE E INFERÊNCIA COM DADOS INÉDITOS\n",
        "# ==============================================================================\n",
        "# Define uma nova lista com uma frase inédita que o modelo NUNCA viu durante o treino\n",
        "nova_mensagem_teste = [\"não achei o atendimento péssimo\"]\n",
        "\n",
        "# Transforma a nova frase em números usando a MESMA estrutura de vocabulário criada no treino (transform)\n",
        "matriz_nova_mensagem = vetorizador.transform(nova_mensagem_teste)\n",
        "\n",
        "# O método predict faz a inferência e devolve a classe prevista (positivo ou negativo)\n",
        "predicao_resultado = modelo_classificador.predict(matriz_nova_mensagem)\n",
        "\n",
        "# Imprime a frase enviada para o teste\n",
        "print(f\"Mensagem enviada para análise: '{nova_mensagem_teste[0]}'\")\n",
        "\n",
        "# Imprime o resultado da classificação em letras maiúsculas para facilitar a leitura\n",
        "print(f\"Sentimento Previsto pelo Modelo: {predicao_resultado[0].upper()}\")"
      ]
